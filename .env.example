# Workspace Core environment contract.
#
# This file is the authoritative inventory of every environment input this repository
# intentionally supports. Copy it to a private `.env` and edit the placeholders; `.env` itself is
# never committed.
#
# Conventions used below:
#   ACTIVE key      the supported input, shown at its current effective default
#   COMMENTED key   an optional override knob; the comment says what it does and what happens
#                   when it is left absent
#
# Every value here is local-safe. No entry is a real or production-usable credential.
#
# Both configuration gates read this file directly, so it must stay renderable:
#   docker compose --env-file .env.example -f infra/docker-compose.dev.yml config --quiet
#   make kafka-config-check ENV_FILE=.env.example

# Workspace Core HTTP
SERVER_PORT=8081
WORKSPACE_CORE_MAX_FILE_SIZE=200MB
WORKSPACE_CORE_MAX_REQUEST_SIZE=200MB

# Product authentication mode: legacy_session (default) or keycloak_jwt (opt-in foundation)
WORKSPACE_CORE_SECURITY_AUTHENTICATION_MODE=legacy_session
# Required only when WORKSPACE_CORE_SECURITY_AUTHENTICATION_MODE=keycloak_jwt
WORKSPACE_CORE_SECURITY_OIDC_ISSUER_URI=
# Optional explicit JWKS endpoint for local/OIDC deployments; issuer validation still uses the issuer URI
WORKSPACE_CORE_SECURITY_OIDC_JWK_SET_URI=
# Optional audience validation for access tokens
WORKSPACE_CORE_SECURITY_OIDC_AUDIENCE=

# Local Keycloak profile-gated infrastructure for future OIDC/JWT smoke.
# These are local placeholders only; replace them in your private .env before starting the keycloak profile.
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.6.3
KEYCLOAK_PORT=8180
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-local-only
# Temporary local admin bootstrap account for realm setup/smoke only.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=temp-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=change-me-local-only
# The realm, client and audience names are baked into infra/keycloak/realm-import/
# workspace-dev-realm.json and are not read from the environment by anything in this repository.
# They are recorded here only because the commented keycloak_jwt block below is built from them;
# setting them on their own changes nothing.
# KEYCLOAK_REALM=workspace-dev
# KEYCLOAK_FRONTEND_CLIENT_ID=workspace-web
# KEYCLOAK_RESOURCE_AUDIENCE=workspace-core

# Future local JWT smoke guidance; keep legacy_session as the default until that smoke is intentional.
# WORKSPACE_CORE_SECURITY_AUTHENTICATION_MODE=keycloak_jwt
# WORKSPACE_CORE_SECURITY_OIDC_ISSUER_URI=http://localhost:8180/realms/workspace-dev
# WORKSPACE_CORE_SECURITY_OIDC_JWK_SET_URI=
# WORKSPACE_CORE_SECURITY_OIDC_AUDIENCE=workspace-core

# Current-user resolution. Identity comes only from the authenticated session established by
# register/login (or, in keycloak_jwt mode, a validated bearer token); there is no development
# identity fallback and no supported user-id header. Optional: the HTTP session attribute name
# the authenticated user id is stored under (default: CURRENT_USER_ID).
# CURRENT_USER_SESSION_ATTRIBUTE=CURRENT_USER_ID

# Default workspace, created on demand per user with a deterministic per-user ID. Overriding the
# name on an existing database does not rename workspaces already stored.
# DEFAULT_WORKSPACE_NAME='Default Workspace'

# External FastAPI dependency (Repo A)
FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_CONNECT_TIMEOUT=5s
FASTAPI_READ_TIMEOUT=30s
FASTAPI_ASSISTANT_ANSWER_PATH=/internal/assistant/answer
FASTAPI_ASSISTANT_READ_TIMEOUT=30s
# Optional shared service credential for the processor's internal API (a secret — never
# commit a real value). Absent or blank, no Authorization header is sent, which matches a
# processor running with authentication disabled; when the processor enforces it, set this
# to the same value as the processor's INTERNAL_API_TOKEN.
#FASTAPI_INTERNAL_TOKEN=

# Repo B local PostgreSQL — the product source of truth.
# HOST is read only by Spring; PORT, DB, USER and PASSWORD are read by both Spring and the
# Compose container, so the two always agree. The password has no default in application.yml:
# the application fails to start when it is absent rather than falling back to a usable value.
WORKSPACE_CORE_POSTGRES_HOST=localhost
WORKSPACE_CORE_POSTGRES_PORT=5434
WORKSPACE_CORE_POSTGRES_DB=workspace_core
WORKSPACE_CORE_POSTGRES_USER=workspace_core
WORKSPACE_CORE_POSTGRES_PASSWORD=workspace_core

# Schema management. Flyway owns the schema (migrations V1-V7) and Hibernate only validates it.
# These are override knobs, not routine settings; absent, the defaults shown apply.
# WORKSPACE_CORE_JPA_DDL_AUTO=validate
# WORKSPACE_CORE_FLYWAY_ENABLED=true
# WORKSPACE_CORE_FLYWAY_BASELINE_ON_MIGRATE=false

# Repo B local Elasticsearch — the derived read model, rebuildable from PostgreSQL.
# Container settings. ELASTICSEARCH_PORT is the host port only; it does not reach Spring.
ELASTICSEARCH_PORT=9201
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.11.1
ELASTICSEARCH_JAVA_OPTS='-Xms512m -Xmx512m'
# Client settings Spring reads. ELASTICSEARCH_BASE_URL is the endpoint the application actually
# uses, so it must be changed alongside ELASTICSEARCH_PORT — changing the host port on its own
# leaves the application pointing at the old one.
ELASTICSEARCH_BASE_URL=http://localhost:9201
ELASTICSEARCH_CONNECT_TIMEOUT=3s
ELASTICSEARCH_READ_TIMEOUT=10s
ELASTICSEARCH_TRANSCRIPT_INDEX_NAME=asset-transcript-rows

# Repo B local MinIO object storage
WORKSPACE_CORE_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
WORKSPACE_CORE_OBJECT_STORAGE_REGION=us-east-1
WORKSPACE_CORE_OBJECT_STORAGE_BUCKET=workspace-media
WORKSPACE_CORE_OBJECT_STORAGE_ACCESS_KEY=minioadmin
WORKSPACE_CORE_OBJECT_STORAGE_SECRET_KEY=minioadmin
WORKSPACE_CORE_OBJECT_STORAGE_PATH_STYLE_ACCESS=true
WORKSPACE_CORE_OBJECT_STORAGE_PORT=9000
WORKSPACE_CORE_OBJECT_STORAGE_CONSOLE_PORT=9001
# Container image pins for the MinIO server and the one-shot bucket-creation job. Both track a
# floating `latest` tag; pin them to a digest or a released tag to make local startup repeatable.
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest

# Repo B local Kafka event transport
KAFKA_IMAGE=apache/kafka:4.0.2
KAFKA_HEAP_OPTS='-Xms256m -Xmx512m'
KAFKA_MEMORY_RESERVATION=512m
KAFKA_MEMORY_LIMIT=1g
KAFKA_RESTART_POLICY=unless-stopped
WORKSPACE_CORE_KAFKA_PORT=9092
WORKSPACE_CORE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Topic names. All four are read by Spring and by the kafka-create-topics job, which creates
# each one at stack startup, so an override here must be set before the topics are created.
# The v2 request topic is the one the processing relay publishes to; upload requests stay on v1.
WORKSPACE_CORE_KAFKA_PROCESSING_REQUESTED_TOPIC=asset.processing.requested.v1
WORKSPACE_CORE_KAFKA_PROCESSING_REQUESTED_V2_TOPIC=asset.processing.requested.v2
WORKSPACE_CORE_KAFKA_PROCESSING_RESULT_TOPIC=asset.processing.result.v1
WORKSPACE_CORE_KAFKA_INDEXING_REQUESTED_TOPIC=asset.indexing.requested.v1
WORKSPACE_CORE_KAFKA_PROCESSING_RESULT_LISTENER_ENABLED=false
WORKSPACE_CORE_KAFKA_PROCESSING_RESULT_CONSUMER_GROUP=workspace-processing-result-v1
WORKSPACE_CORE_KAFKA_PROCESSING_RESULT_AUTO_OFFSET_RESET=latest
WORKSPACE_CORE_KAFKA_INDEXING_LISTENER_ENABLED=false
WORKSPACE_CORE_KAFKA_INDEXING_CONSUMER_GROUP=workspace-search-indexer-v1
WORKSPACE_CORE_KAFKA_INDEXING_AUTO_OFFSET_RESET=latest
WORKSPACE_CORE_KAFKA_SEND_TIMEOUT=10s
WORKSPACE_CORE_KAFKA_ENABLED=false
WORKSPACE_CORE_KAFKA_LOGGING_PLACEHOLDER_ENABLED=false

# Derived search indexing; explicit indexing remains available, automatic request creation is opt-in
WORKSPACE_CORE_SEARCH_INDEXING_AUTO_REQUEST_ENABLED=false
# How long a job may hold an indexing claim before the worker holding it is presumed dead. Also the
# threshold behind project3.search.index.stuck, so detection and recovery stay aligned.
WORKSPACE_CORE_SEARCH_INDEXING_STALE_AGE=5m
# Bounded replay of indexing jobs abandoned mid-attempt; Project3 enables it. Replay repeats the
# whole attempt, which is safe because an attempt replaces the asset's documents rather than adding.
WORKSPACE_CORE_SEARCH_INDEXING_RECOVERY_ENABLED=false
WORKSPACE_CORE_SEARCH_INDEXING_RECOVERY_INTERVAL=60s
WORKSPACE_CORE_SEARCH_INDEXING_RECOVERY_BATCH_SIZE=20
# Automatic indexing request relay; disabled by default and only relays due asset.indexing.requested rows
WORKSPACE_CORE_SEARCH_INDEXING_RELAY_ENABLED=false
WORKSPACE_CORE_SEARCH_INDEXING_RELAY_FIXED_DELAY=10s
WORKSPACE_CORE_SEARCH_INDEXING_RELAY_BATCH_SIZE=10
# Operator projection rebuild: none, report_candidates, or rebuild_all. Reconstructs Elasticsearch
# from canonical PostgreSQL transcripts; `make search-rebuild` sets it for one run. Never leave it
# set in a long-running deployment — the process exits when the command finishes.
WORKSPACE_CORE_SEARCH_REBUILD_COMMAND=none
WORKSPACE_CORE_SEARCH_REBUILD_BATCH_SIZE=50
# Manual search smoke controls: none or relay_indexing_outbox_once
WORKSPACE_CORE_SEARCH_SMOKE_COMMAND=none
# Required only for relay_indexing_outbox_once
WORKSPACE_CORE_SEARCH_SMOKE_INDEXING_OUTBOX_EVENT_ID=

# Automatic processing request relay; the project3 profile enables it with Kafka
WORKSPACE_CORE_PROCESSING_REQUEST_RELAY_ENABLED=false
WORKSPACE_CORE_PROCESSING_REQUEST_RELAY_FIXED_DELAY=10s
WORKSPACE_CORE_PROCESSING_REQUEST_RELAY_BATCH_SIZE=10
# Manual smoke controls: none, relay_request_outbox_once, or handle_result_file_once
WORKSPACE_CORE_PROCESSING_SMOKE_COMMAND=none
# Required only for relay_request_outbox_once
WORKSPACE_CORE_PROCESSING_SMOKE_REQUEST_OUTBOX_EVENT_ID=
# Required only for handle_result_file_once
WORKSPACE_CORE_PROCESSING_SMOKE_RESULT_EVENT_FILE=

# Manual operator recovery controls: none, retry_failed_result_event_once, or requeue_stuck_outbox_event_once
WORKSPACE_CORE_PROCESSING_RECOVERY_COMMAND=none
# Required only for retry_failed_result_event_once
WORKSPACE_CORE_PROCESSING_RECOVERY_RESULT_EVENT_ID=
# Required only for requeue_stuck_outbox_event_once
WORKSPACE_CORE_PROCESSING_RECOVERY_OUTBOX_EVENT_ID=
# Minimum age before a selected PUBLISHING outbox row can be requeued; empty and negative values are rejected
WORKSPACE_CORE_PROCESSING_RECOVERY_MINIMUM_PUBLISHING_AGE=5m

# Outbox relay foundation; disabled until it is manually invoked against Kafka in later local checks
WORKSPACE_CORE_OUTBOX_RELAY_ENABLED=false
WORKSPACE_CORE_OUTBOX_RELAY_BATCH_SIZE=20
WORKSPACE_CORE_OUTBOX_RELAY_MAX_ATTEMPTS=5
WORKSPACE_CORE_OUTBOX_RELAY_RETRY_DELAY=30s
# Bounded automatic reconciliation for classified transient FAILED outbox rows and for publication
# claims abandoned by a crashed relay; Project3 enables it.
WORKSPACE_CORE_OUTBOX_RECOVERY_ENABLED=false
WORKSPACE_CORE_OUTBOX_RECOVERY_INTERVAL=30s
WORKSPACE_CORE_OUTBOX_RECOVERY_COOLDOWN=60s
# How long a PUBLISHING claim may stand before the relay holding it is presumed dead and the row is
# requeued. Also the threshold behind project3.outbox.stuck, so detection and repair stay aligned.
# Must stay well above the Kafka send timeout; recovery republishes, so consumers see at-least-once.
WORKSPACE_CORE_OUTBOX_RECOVERY_STALE_PUBLISHING_AGE=5m
WORKSPACE_CORE_OUTBOX_RECOVERY_BATCH_SIZE=50
WORKSPACE_CORE_OUTBOX_RECOVERY_MAX_CYCLES=3

# Optional smoke helper overrides — read from the environment by
# infra/scripts/smoke-thin-slice.sh. `make smoke` does not source this file, so export these or
# run the script directly. The helper's other inputs (SMOKE_AUTH_EMAIL, SMOKE_AUTH_PASSWORD,
# SMOKE_VERIFY_CONTEXT, SMOKE_CONTEXT_WINDOW, WORKSPACE_NAME) are Makefile overrides passed on
# the command line and are documented by `make help`; they are deliberately not duplicated here.
# WORKSPACE_CORE_BASE_URL=http://localhost:8081
# SMOKE_POLL_INTERVAL_SECONDS=3
# SMOKE_POLL_TIMEOUT_SECONDS=180

# Not a supported input yet. The Redis service in infra/docker-compose.dev.yml is commented out,
# so nothing reads this; it is reserved for the milestone that introduces Redis.
# WORKSPACE_CORE_REDIS_PORT=6380

# --- Local deployment resource policy (Phase 10) ---------------------------------------------
# Bounded for a developer machine. Elasticsearch was previously observed exiting with 137
# (OOM-killed) when another workload saturated Docker Desktop; the container limit is set above
# JVM heap plus off-heap and page-cache headroom rather than at the heap size.
INFRA_RESTART_POLICY=unless-stopped
POSTGRES_MEMORY_LIMIT=1g
ELASTICSEARCH_MEMORY_LIMIT=1500m
ELASTICSEARCH_MEMORY_RESERVATION=1g
MINIO_MEMORY_LIMIT=512m

# --- Build identity --------------------------------------------------------------------------
# Optional. The Maven build stamps META-INF/build-info.properties; pass the revision explicitly
# with: mvn -Dbuild.git.commit=$(git rev-parse HEAD) ...
# The frontend reads VITE_APP_REVISION at build time only.
